# Postgres
POSTGRES_USER=arturodev
POSTGRES_PASSWORD=
POSTGRES_DB=arturodev

# Backend
DATABASE_URL=postgresql://arturodev:@postgres:5432/arturodev
JWT_SECRET=

# Auth (admin unico, seed idempotente)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Origen exacto del frontend (scheme+host). Se usa para CORS y para el
# chequeo CSRF por Origin/Referer. En prod: https://arturodev.info
ALLOWED_ORIGIN=http://localhost:3000
# Dominio del cookie de sesion. Vacio funciona para localhost (host-only).
# En prod usar ".arturodev.info" para compartir la cookie entre
# arturodev.info y api.arturodev.info.
COOKIE_DOMAIN=

# Frontend: URL publica del backend (se hornea en el build de Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Frontend: URL publica del sitio (para sitemap.xml). En prod: https://arturodev.info
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (formulario de contacto)
RESEND_API_KEY=
CONTACT_EMAIL=

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Frontend: mismo valor que RECAPTCHA_SITE_KEY (se hornea en el build, es
# publico por diseno — el secret nunca va al frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
